{
	"name": "drago-ex/project-front",
	"description": "The package adds a basic frontend module to Drago Project.",
	"type": "drago-tools-resource",
	"license": ["MIT"],
	"require": {
		"php": ">=8.3 <9",
		"drago-ex/translator": "^4.0",
		"drago-ex/application": "^3.0"
	},
	"suggest": {
		"drago-ex/permission": "Enables generation of the frontend permission provider."
	},
	"require-dev": {
		"phpstan/phpstan-nette": "^2.0"
	},
	"bin": ["bin/create-front-permission"],
	"extra": {
		"drago-tools": {
			"install": {
				"copy": {
					"resources/app": "app",
					"resources/assets": "assets"
				}
			},
			"commands": {
				"create:front-permission": "php vendor/bin/create-front-permission"
			}
		}
	},
	"scripts": {
		"phpstan": "phpstan analyse"
	}
}
