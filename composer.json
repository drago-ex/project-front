{
	"name": "drago-ex/project-front",
	"type": "drago-tools-resource",
	"description": "The package adds a basic frontend module to Drago Project.",
	"license": ["MIT"],
	"require": {
		"php": ">=8.3 <9",
		"drago-ex/translator": "^3.0",
		"drago-ex/application": "^2.0"
	},
	"extra": {
		"drago-tools": {
			"install": {
				"copy": {
					"resources/app": "app",
					"resources/assets": "assets"
				}
			},
			"commands": {
				"create:front-permission": "php vendor/bin/create-permission"
			}
		}
	},
	"require-dev": {
		"phpstan/phpstan-nette": "^2.0"
	},
	"bin": [
	  "bin/create-permission"
	],
	"scripts": {
		"phpstan": "phpstan analyse"
	}
}
