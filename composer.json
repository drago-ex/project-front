{
	"name": "drago-ex/project-user",
	"type": "composer-plugin",
	"description": "The package adds a basic frontend module to Drago Project.",
	"require": {
		"php": ">=8.3 <9",
		"nette/di": "^3.2",
	  	"drago-ex/translator": "^1.0",
	  	"drago-ex/application": "^1.0",
		"composer-plugin-api": "^2.3"
	},
	"autoload": {
		"psr-4": {
			"DragoFrontPlugin\\": "src/"
		}
	},
	"extra": {
		"class": "DragoFrontPlugin\\Composer\\Plugin"
	},
	"require-dev": {
		"composer/composer": "^2.9",
		"phpstan/phpstan-nette": "^1.2.9"
	},
	"scripts": {
		"phpstan": "phpstan analyse --level 5 --configuration phpstan.neon resources/app"
	}
}
