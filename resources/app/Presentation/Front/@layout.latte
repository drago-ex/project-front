{templateType App\Presentation\Front\Home\HomeTemplate}
{varType Drago\Application\UI\Flashes[] $flashes}

<!doctype html>
<html lang="{$lang}">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>{ifset title}{include title|stripHtml|firstUpper} &bull; {/ifset} Frontend</title>
	{* a page sets $description (e.g. a static page) to get a meta description for search engines *}
	<meta n:ifset="$description" name="description" content={$description}>

	{asset 'front.js'}
</head>

<body>

{* main content *}
<main role="main" class="mt-3 container">

	{* flash messages *}
	{snippet message}
		{include '../Accessory/Widget/@flash-message.latte', flashes: $flashes}
	{/snippet}

	{* page content *}
	{include content}
</main>

{* footer info *}
<footer class="text-center mt-4 text-muted small">
	Vite + Nette - ready to code!
</footer>

</body>
</html>
